# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# On Vercel, set these per environment in Project Settings → Environment Variables;
# the Neon Marketplace integration adds the DATABASE_URL* values itself.

# Neon pooled connection string (host contains "-pooler"). Use a Neon *dev*
# branch locally, never the production branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional: Neon direct (unpooled) connection string. `pnpm db:migrate` prefers it.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Signs session cookies. At least 32 random characters, different per environment.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this deployment, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=http://localhost:3000

# Integration tests only: a throwaway Postgres the tests may create and drop
# databases in (see docs/DEVELOPMENT.md). Leave unset to skip those tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
