{
  "name": "gmaps-pos-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:create-admin": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-admin.ts",
    "db:import": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-leads.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
